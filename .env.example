# Bu dosya olmadan da uygulama calisir; asagidakiler sadece varsayilanlari degistirmek icin.
# Foundry Local'i baslattiktan sonra "foundry service status" komutuyla
# gercek adresi ve portu gorebilirsin, asagidakini ona gore guncelle.
# Port sabitlemek icin: foundry service set --port 5273
FOUNDRY_BASE_URL=http://localhost:5273/v1

# BOS BIRAK: model adi her bilgisayarda farkli olabildigi icin (cpu/gpu surumu, surum
# numarasi) uygulama indirilmis modeli Foundry'den otomatik buluyor. Belirli bir modeli
# zorlamak istersen adini "foundry model list --downloaded" ile ogrenip buraya yaz.
FOUNDRY_MODEL=

# Port 3000 doluysa burayi degistir.
PORT=3000
